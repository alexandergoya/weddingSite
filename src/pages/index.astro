---
import Layout from '~/layouts/WeddingLayout.astro';
import Hero from '~/components/widgets/WeddingHero.astro';
import OurStory from '~/components/widgets/OurStory.astro';
import EventDetails from '~/components/widgets/EventDetails.astro';
import PhotoGallery from '~/components/widgets/PhotoGallery.astro';
import RSVP from '~/components/widgets/RSVP.astro';
import Announcements from '~/components/widgets/Announcements.astro';
import FAQs from '~/components/widgets/WeddingFAQs.astro';
import Accommodations from '~/components/widgets/Accommodations.astro';
import Registry from '~/components/widgets/Registry.astro';
import Footer from '~/components/widgets/WeddingFooter.astro';

const metadata = {
  title: 'Elle & Alexander — October 16, 2026',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero />
  <OurStory />
  <EventDetails />
  <RSVP />
  <Announcements />
  <FAQs />
  <Accommodations />
  <Registry />
  <PhotoGallery />
  <Footer />
</Layout>
