---
import { getCollection } from 'astro:content';
import { SITE } from 'astrowind:config';
import { trimSlash } from '~/utils/permalinks';

const posts = await getCollection('post');

const canonicalURL = new URL(Astro.url.pathname, SITE.site);

const meta = {
  title: 'Alexander & Elle — Announcements',
  description: SITE?.metadata?.description,
};
---

<html lang={SITE?.i18n?.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonicalURL} />
  </head>
  <body class="antialiased text-default bg-page tracking-tight">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <a href="/" class="text-primary hover:underline mb-8 inline-block">← Back to home</a>
      <h1 class="font-serif text-4xl md:text-5xl text-heading mb-12">Announcements</h1>

      <div class="space-y-8">
        {posts
          .filter((post) => !post.data.draft)
          .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
          .map((post) => (
            <article class="bg-card rounded-lg shadow-sm p-6 md:p-8 border border-border/20">
              <time class="text-muted text-sm">
                {post.data.publishDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <h2 class="font-serif text-2xl text-heading mt-2 mb-3">{post.data.title}</h2>
              {post.data.excerpt && <p class="text-muted">{post.data.excerpt}</p>}
              <a
                href={`/announcements/${post.id.replace(/\.mdx?$/, '')}`}
                class="inline-block mt-4 text-primary hover:underline text-sm font-medium"
              >
                Read more →
              </a>
            </article>
          ))}
      </div>
    </div>
  </body>
</html>
