---
import { getCollection, render } from 'astro:content';
import { SITE } from 'astrowind:config';
import Layout from '~/layouts/PageLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('post');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { post: post.id.replace(/\.mdx?$/, '') },
      props: { post },
    }));
}

const { post } = Astro.props;
const { title, publishDate, excerpt } = post.data;
const { Content } = await render(post);

const meta = {
  title: title,
  description: excerpt || SITE?.metadata?.description,
};
---

<Layout metadata={meta}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <a href="/announcements" class="text-primary hover:underline mb-8 inline-block">← All announcements</a>
    <time class="text-muted text-sm">
      {publishDate.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </time>
    <h1 class="font-serif text-4xl md:text-5xl text-heading mt-2 mb-8">{title}</h1>
    <article class="prose prose-lg max-w-none prose-headings:font-serif prose-a:text-primary">
      <Content />
    </article>
  </div>
</Layout>
