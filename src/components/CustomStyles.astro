---
import '@fontsource-variable/playfair-display';
import '@fontsource/lato';
---

<style is:inline>
  /* Sedona Theme — pulled from the invitation watercolor */
  :root[data-theme='sedona'],
  :root:not([data-theme]) {
    --aw-font-sans: 'Lato Variable';
    --aw-font-serif: 'Playfair Display Variable';
    --aw-font-heading: 'Playfair Display Variable';

    --aw-color-primary: #6b8fa3;
    --aw-color-secondary: #7a8b5c;
    --aw-color-accent: #c0452c;

    --aw-color-text-heading: #3d2b1f;
    --aw-color-text-default: #5a453a;
    --aw-color-text-muted: #7d6b5d;
    --aw-color-bg-page: #fdf6f0;
    --aw-color-bg-page-dark: #3d2b22;
    --aw-color-bg-card: #ffffff;
    --aw-color-border: #e8c4a0;

    ::selection {
      background-color: #6b8fa3;
      color: #fdf6f0;
    }
  }

  /* Forest Theme */
  :root[data-theme='forest'] {
    --aw-font-sans: 'Lato Variable';
    --aw-font-serif: 'Playfair Display Variable';
    --aw-font-heading: 'Playfair Display Variable';

    --aw-color-primary: #2d5a3d;
    --aw-color-secondary: #1b4332;
    --aw-color-accent: #8b6914;

    --aw-color-text-heading: #1a1a1a;
    --aw-color-text-default: #2c2c2c;
    --aw-color-text-muted: #4a4a4a;
    --aw-color-bg-page: #faf8f5;
    --aw-color-bg-page-dark: #1b4332;
    --aw-color-bg-card: #ffffff;
    --aw-color-border: #d4c9a8;

    ::selection {
      background-color: #2d5a3d;
      color: #faf8f5;
    }
  }

  /* Desert Theme */
  :root[data-theme='desert'] {
    --aw-font-sans: 'Lato Variable';
    --aw-font-serif: 'Playfair Display Variable';
    --aw-font-heading: 'Playfair Display Variable';

    --aw-color-primary: #c67b5c;
    --aw-color-secondary: #a0522d;
    --aw-color-accent: #d4a574;

    --aw-color-text-heading: #2c1810;
    --aw-color-text-default: #3d2b1f;
    --aw-color-text-muted: #6b5344;
    --aw-color-bg-page: #fdf6ee;
    --aw-color-bg-page-dark: #a0522d;
    --aw-color-bg-card: #ffffff;
    --aw-color-border: #d4a574;

    ::selection {
      background-color: #c67b5c;
      color: #fdf6ee;
    }
  }

  /* Celebration Theme — cerulean, leaf green, sunset orange, dark fuchsia */
  :root[data-theme='celebration'] {
    --aw-font-sans: 'Lato Variable';
    --aw-font-serif: 'Playfair Display Variable';
    --aw-font-heading: 'Playfair Display Variable';

    --aw-color-primary: #007ba7;
    --aw-color-secondary: #328d02;
    --aw-color-accent: #e46d19;

    --aw-color-text-heading: #a62a73;
    --aw-color-text-default: #2c3e42;
    --aw-color-text-muted: #5a6e72;
    --aw-color-bg-page: #f5f9fa;
    --aw-color-bg-page-dark: #102026;
    --aw-color-bg-card: #ffffff;
    --aw-color-border: #b8d4e3;

    ::selection {
      background-color: #007ba7;
      color: #f5f9fa;
    }
  }

  .dark[data-theme='sedona'],
  .dark:not([data-theme]) {
    --aw-color-primary: #8ab0c2;
    --aw-color-secondary: #8fa372;
    --aw-color-accent: #d9896a;
    --aw-color-text-heading: #f5ede5;
    --aw-color-text-default: #d9c5b2;
    --aw-color-text-muted: #b89e86;
    --aw-color-bg-page: #2c1f18;
    --aw-color-bg-page-dark: #1a1210;
    --aw-color-bg-card: #3d2b22;
    --aw-color-border: #8ab0c2;
  }

  .dark[data-theme='forest'] {
    --aw-color-primary: #40916c;
    --aw-color-secondary: #2d5a3d;
    --aw-color-accent: #b8860b;
    --aw-color-text-heading: #f0ede6;
    --aw-color-text-default: #d4cfc5;
    --aw-color-text-muted: #a8a296;
    --aw-color-bg-page: #1a2e23;
    --aw-color-bg-page-dark: #0d1f17;
    --aw-color-bg-card: #1e3328;
    --aw-color-border: #40916c;
  }

  .dark[data-theme='desert'] {
    --aw-color-primary: #d4956a;
    --aw-color-secondary: #c67b5c;
    --aw-color-accent: #e8c4a0;
    --aw-color-text-heading: #f5ede5;
    --aw-color-text-default: #d9c5b2;
    --aw-color-text-muted: #b89e86;
    --aw-color-bg-page: #2c1f18;
    --aw-color-bg-page-dark: #1a1210;
    --aw-color-bg-card: #3d2b22;
    --aw-color-border: #d4956a;
  }

  .dark[data-theme='celebration'] {
    --aw-color-primary: #4db8d9;
    --aw-color-secondary: #5cb85c;
    --aw-color-accent: #ff9a5e;
    --aw-color-text-heading: #f5f0e8;
    --aw-color-text-default: #d1e0e6;
    --aw-color-text-muted: #8ba3ad;
    --aw-color-bg-page: #0d1f26;
    --aw-color-bg-page-dark: #081419;
    --aw-color-bg-card: #142a33;
    --aw-color-border: #4db8d9;
  }
</style>
