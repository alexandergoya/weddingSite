---
import { SITE, METADATA, I18N } from '~/config';
import type { MetaData, MetaDataOpenGraph } from '~/types';
import { getCanonical } from '~/utils/permalinks';
import { adaptOpenGraphImages } from '~/utils/images';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
} = Astro.props;

const mergedOg: MetaDataOpenGraph = {
  siteName: SITE?.name,
  locale: I18N?.language || 'en',
  ...METADATA?.openGraph,
  url: canonical,
  ...openGraph,
};

const adaptedOg = await adaptOpenGraphImages(mergedOg, Astro.site);
const firstImage = adaptedOg?.images?.[0];

const finalTitle = title || METADATA?.title?.default || '';
const titleTemplate = ignoreTitleTemplate ? '%s' : METADATA?.title?.template || '%s';
const formattedTitle = titleTemplate.replace('%s', finalTitle);

const finalDescription = description || METADATA?.description;

const noindex =
  typeof robots?.index !== 'undefined'
    ? !robots.index
    : typeof METADATA?.robots?.index !== 'undefined'
      ? !METADATA.robots.index
      : true;

const nofollow =
  typeof robots?.follow !== 'undefined'
    ? !robots.follow
    : typeof METADATA?.robots?.follow !== 'undefined'
      ? !METADATA.robots.follow
      : true;

const robotsContent = `${noindex ? 'noindex' : 'index'}, ${nofollow ? 'nofollow' : 'follow'}`;

const twitterCard = firstImage ? 'summary_large_image' : 'summary';
---

<title>{formattedTitle}</title>
<link rel="canonical" href={canonical} />
{finalDescription && <meta name="description" content={finalDescription} />}
<meta name="robots" content={robotsContent} />

<meta property="og:title" content={finalTitle} />
<meta property="og:type" content={mergedOg?.type || 'website'} />
<meta property="og:url" content={String(canonical)} />
{finalDescription && <meta property="og:description" content={finalDescription} />}
{mergedOg?.siteName && <meta property="og:site_name" content={mergedOg.siteName} />}
{mergedOg?.locale && <meta property="og:locale" content={mergedOg.locale} />}
{firstImage?.url && <meta property="og:image" content={firstImage.url} />}
{firstImage?.width && <meta property="og:image:width" content={String(firstImage.width)} />}
{firstImage?.height && <meta property="og:image:height" content={String(firstImage.height)} />}

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={finalTitle} />
{finalDescription && <meta name="twitter:description" content={finalDescription} />}
{firstImage?.url && <meta name="twitter:image" content={firstImage.url} />}
