---
import { Image as AstroImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { findImage } from '~/utils/images';

interface Props extends Omit<HTMLAttributes<'img'>, 'src'> {
  src?: string | ImageMetadata | null;
  widths?: number[];
  format?: string;
}

const { src, alt, widths, format, ...rest } = Astro.props;

if (alt === undefined || alt === null) {
  throw new Error(`Image: missing required \`alt\` prop. Pass alt="" explicitly for decorative images.`);
}

const resolved = await findImage(src);
---

{
  resolved && (
    <AstroImage
      {...({
        ...rest,
        src: resolved,
        alt,
        widths,
        format,
      } as unknown as Parameters<typeof AstroImage>[0])}
    />
  )
}
