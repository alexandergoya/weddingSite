---
import { Icon } from 'astro-icon/components';

const navLinks = [
  { text: 'Our Story', href: '#our-story' },
  { text: 'Details', href: '#details' },
  { text: 'RSVP', href: '#rsvp' },
  { text: 'Announcements', href: '#announcements' },
  { text: 'FAQs', href: '#faq' },
  { text: 'Accommodations', href: '#accommodations' },
  { text: 'Registry', href: '#registry' },
  { text: 'Photos', href: '#photos' },
];
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="bg-page/80 backdrop-blur-md border-b border-border/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 md:h-20">
        <a href="#hero" class="font-serif text-xl md:text-2xl text-primary font-bold tracking-wide">
          E <span class="text-accent">&amp;</span> A
        </a>

        <nav class="hidden md:flex items-center space-x-6" aria-label="Main navigation">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="text-sm font-medium text-default/80 hover:text-primary transition-colors duration-200"
              >
                {link.text}
              </a>
            ))
          }
        </nav>

        <div class="md:hidden flex items-center space-x-3">
          <button
            id="mobile-menu-btn"
            type="button"
            class="text-default p-2 rounded-md hover:bg-primary/10 transition-colors"
            aria-label="Toggle menu"
            aria-expanded="false"
          >
            <Icon name="tabler:menu-2" class="w-6 h-6" />
          </button>
        </div>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden border-t border-border/20">
      <nav class="px-4 py-4 space-y-2" aria-label="Mobile navigation">
        {
          navLinks.map((link) => (
            <a href={link.href} class="block py-2 text-default/80 hover:text-primary transition-colors">
              {link.text}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
