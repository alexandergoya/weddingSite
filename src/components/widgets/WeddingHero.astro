---

---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-primary/10"></div>

  <div class="relative z-10 text-center px-4 sm:px-6 max-w-4xl mx-auto">
    <p class="text-accent font-serif text-lg md:text-xl mb-4 tracking-widest uppercase">We're getting married</p>

    <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-heading mb-6 leading-tight">
      Elle <span class="text-accent">&amp;</span> Alexander
    </h1>

    <div class="flex items-center justify-center space-x-4 text-default/80 mb-8">
      <span class="font-serif text-xl md:text-2xl">August 28, 2026</span>
      <span class="text-accent">•</span>
      <span class="font-serif text-xl md:text-2xl">TBD</span>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#rsvp" class="btn-primary px-8 py-4 text-lg font-serif"> RSVP </a>
      <a
        href="#our-story"
        class="btn-secondary px-8 py-4 text-lg font-serif border-primary text-primary hover:bg-primary hover:text-white"
      >
        Our Story
      </a>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-primary/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>
