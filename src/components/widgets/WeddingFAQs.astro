---
import { Icon } from 'astro-icon/components';

const faqs = [
  {
    question: "What's the dress code?",
    answer: `Cocktail attire — wear something elegant but comfortable. Our colors are cerulean, leaf green, sunset orange, and dark fuchsia; use them as inspiration if you like (they also make up this sick website theme).
      <div class="flex flex-wrap gap-3 mt-4">
        <div class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-white shadow-sm" style="background-color: #007BA7;">
          <span class="w-4 h-4 rounded-full border border-white/40 bg-white/20"></span> Cerulean
        </div>
        <div class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-white shadow-sm" style="background-color: #328D02;">
          <span class="w-4 h-4 rounded-full border border-white/40 bg-white/20"></span> Leaf Green
        </div>
        <div class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-white shadow-sm" style="background-color: #e46d19;">
          <span class="w-4 h-4 rounded-full border border-white/40 bg-white/20"></span> Sunset Orange
        </div>
        <div class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-white shadow-sm" style="background-color: #a62a73;">
          <span class="w-4 h-4 rounded-full border border-white/40 bg-white/20"></span> Dark Fuchsia
        </div>
      </div>`,
  },
  {
    question: 'Is there parking at the venue?',
    answer: 'The Doyle has plenty of parking available',
  },
  {
    question: 'Are children welcome?',
    answer: 'This event will be adults only.',
  },
  {
    question: 'Can I bring a plus one?',
    answer: 'Absolutely! Please register your guest when you RSVP.',
  },
  {
    question: 'What if I have food allergies?',
    answer: "Please note any dietary restrictions in the RSVP form and we'll get you sorted.",
  },
];
---

<section id="faq" class="py-12 md:py-16 bg-page">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="font-serif text-4xl md:text-5xl text-heading">Frequently Asked Questions</h2>
    </div>

    <div class="space-y-4">
      {
        faqs.map((faq) => (
          <details class="group bg-card rounded-lg border border-border/20 overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 text-default font-medium hover:text-primary transition-colors list-none">
              <span class="font-serif text-lg">{faq.question}</span>
              <Icon
                name="tabler:chevron-down"
                class="w-5 h-5 text-muted transition-transform duration-200 group-open:rotate-180"
              />
            </summary>
            <div class="px-6 pb-6 text-muted leading-relaxed" set:html={faq.answer} />
          </details>
        ))
      }
    </div>
  </div>
</section>
