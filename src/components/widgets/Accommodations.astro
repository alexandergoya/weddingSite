---
import { Icon } from 'astro-icon/components';
---

<section id="accommodations" class="py-12 md:py-16 bg-page">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="font-serif text-4xl md:text-5xl text-heading">Accommodations</h2>
    </div>

    <div class="bg-card rounded-lg shadow-sm p-8 border border-border/20 mb-8">
      <div class="flex items-start gap-4">
        <Icon name="tabler:info-circle" class="w-6 h-6 text-accent flex-shrink-0 mt-1" />
        <div>
          <h3 class="font-serif text-xl text-heading mb-2">Where We're Staying</h3>
          <div class="text-muted leading-relaxed space-y-3">
            <p>
              We don't have an official hotel block, but we'll be staying in the Gallery Tower at the Downtown Grand
              Hotel and we hope as many of you as possible can join us.
            </p>
            <p>
              Booking is available through the hotel's website, but a discounter may be cheaper. Hotels.com had the best
              prices when we checked.
            </p>
            <p>
              <a
                href="https://www.downtowngrand.com/hotel-rooms-downtown-las-vegas/gallery-tower"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:underline inline-flex items-center gap-2"
              >
                Downtown Grand — Gallery Tower
                <Icon name="tabler:external-link" class="w-4 h-4" />
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>

