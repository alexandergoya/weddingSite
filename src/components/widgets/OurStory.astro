---
import { Icon } from 'astro-icon/components';

const base = import.meta.env.BASE_URL;

const timeline = [
  {
    date: 'Freshman Year 2007',
    title: 'A Roma(nce) in Tacoma',
    description: `Elle and Alex meet at the University of Puget Sound as freshmen. They date very functionally and definitely not at all like they are eighteen and idiots. Then Elle summarily dumps Alex in his dorm floor's laundry room.

In the spring, Alex gives Elle a book called "Ants Have Sex in Your Beer" and immediately transfers to UNLV and moves back to Vegas.

However, they keep in touch.`,
    image: 'photos/ElleAlexander_70.jpg',
  },
  {
    date: 'Winter 2016',
    title: 'What If We Dated Again? Jk. Unless...?',
    description: `Elle calls Alex on his birthday in November 2015 and — tempted by the promise of a hot date and shiny new in-unit laundry machines — Alex visits her in Seattle. Two months later Elle visits Alex in Vegas, where he low-key ditches her for five hours to go to the Democratic Party caucus where he doesn't even get Bernie nominated.

Elle is unimpressed and flies home to date some other dude for a while.`,
    image: 'photos/ElleAlexander_69.jpg',
  },
  {
    date: 'Spring 2024',
    title: 'Ah Sh*t, Here We Go Again',
    description: `Alex calls Elle on her birthday in January 2024. Elle gets off the phone and thinks, "it was great catching up with him!" Alex gets off the phone and promptly spends the next month listening to one thousand podcasts about whether or not it's a good idea to date your ex.

Creatures of habit, Alex and Elle start visiting each other again, even as Elle is busy fleeing the hell out of NYC and making a run back to Tacoma.`,
    image: 'photos/ElleAlexander_58.jpg',
  },
  {
    date: 'April 8, 2024',
    title: 'Ohio *Is* For Lovers, Actually',
    description: `Elle gets on a red-eye flight and makes it to Pittsburgh in time for Alex to pick her up in an ancient van with an anxiety disorder. They both make it into Ohio in time to be in the path of totality for a solar eclipse.

Never ones to get things done early, they make things official about two minutes before the main event.

For the next year, Elle and Alex visit each other in Tacoma and D.C.`,
    image: 'photos/ElleAlexander_54.jpg',
  },
  {
    date: 'Summer 2024',
    title: 'At Least the Street Food Was Really Good',
    description: `They spend a month and a half together in the summer having adventures, including a road trip with Alex's family to Baja Mexico. There, they go on a nine-hour boat ride with literally no food and then get shaken down for a bribe by crooked cops literally 100 feet from the border.

The least the cops could have done was let them cut in the two-hour line after the ordeal, but no.`,
    image: 'photos/ElleAlexander_52.jpg',
  },
  {
    date: 'Winter 2024',
    title: 'When in Rome',
    description: `The lovebirds join Alex's mother and her friend Laura on a trip to Rome.

They get scammed into buying expensive tickets for the Colosseum and get there too late to go inside, but they spend half a day wandering the Foro and then Alex gets his phone straight up pickpocketed on the Metro.

They get dressed to the nines and go to a fancy event featuring not enough food but very strong drinks in a remote Black Mirror-esque manse. They do it again the next night and there is still not quite enough food, but this time there is also nonconsensual fish dinner and four sexy Zorros.`,
    image: 'photos/ElleAlexander_31.jpg',
  },
  {
    date: 'March 2025',
    title: "Hittin' the Bricks",
    description: `Alex bails on D.C. right as things start getting uh not great and he and Elle move into a townhouse in Seattle. All of the appliances are low-grade malevolent, there are too many stairs, and neither of them have ever been happier.

They learn the joys of sharing popcorn, couch naps, and a continuous water heater that never runs out of hot water.`,
    image: 'photos/ElleAlexander_23.jpg',
  },
  {
    date: 'May 2026',
    title: "We'll Do It Live",
    description: `On a vacation to Canada, Alex is unusually protective of his suitcase and bag, foiling Elle's desire to get into absolutely everything.

At a scenic overlook in Vancouver, Elle finally breaks and asks Alex to marry her about 14 seconds before he had planned to. Alex pulls a ring out of his pocket for an Uno Reverse and gets on one knee without answering in order to win the first-to-ask prize on a technicality.

Thankfully, they both say yes.`,
    image: 'photos/ElleAlexander_06.jpg',
  },
];
---

<section id="our-story" class="py-12 md:py-16 bg-page">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="font-serif text-4xl md:text-5xl text-heading">Our Story</h2>
    </div>

    <div class="relative">
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-border/50 -translate-x-1/2"></div>

      {
        timeline.map((item, index) => (
          <div
            class:list={[
              'relative flex flex-col md:flex-row items-start md:items-center mb-12 last:mb-0',
              index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse',
            ]}
          >
            <div class:list={['w-full md:w-1/2', index % 2 === 0 ? 'md:pr-12' : 'md:pl-12']}>
              <div class="bg-card rounded-lg shadow-sm p-6 border border-border/20">
                <span class="text-accent font-serif text-sm tracking-wider">{item.date}</span>
                <h3 class="font-serif text-xl text-heading mt-1 mb-2">{item.title}</h3>
                <p class="text-muted text-sm leading-relaxed whitespace-pre-line">{item.description}</p>
              </div>
            </div>

            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-primary border-4 border-page -translate-x-1/2 flex items-center justify-center z-10">
              <Icon name="tabler:heart" class="w-4 h-4 text-white" />
            </div>

            <div class:list={['w-full md:w-1/2 mt-4 md:mt-0', index % 2 === 0 ? 'md:pl-12' : 'md:pr-12']}>
              <div class="rounded-lg overflow-hidden bg-primary/5 border border-border/20">
                <img
                  src={`${base.replace(/\/$/, '')}/${item.image}`}
                  alt={item.title}
                  class="w-full object-contain max-h-96"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
