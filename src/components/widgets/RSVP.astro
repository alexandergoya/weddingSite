---
---

<section id="rsvp" class="py-20 md:py-28 bg-page">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-accent font-serif text-sm tracking-widest uppercase mb-2">Will You Join Us?</p>
      <h2 class="font-serif text-4xl md:text-5xl text-heading mb-4">RSVP</h2>
      <p class="text-muted">Please respond by <span class="text-primary font-medium">July 17, 2026</span></p>
    </div>

    <form
      action="https://formspree.io/f/mdavdaqy"
      method="POST"
      class="bg-card rounded-lg shadow-sm p-8 border border-border/20 space-y-6"
    >
      <div>
        <label for="name" class="block text-sm font-medium text-default mb-2">
          Full Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-4 py-3 rounded-md border border-border/40 bg-page text-default focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
          placeholder="Your name"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-default mb-2">
          Email <span class="text-red-500">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-4 py-3 rounded-md border border-border/40 bg-page text-default focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
          placeholder="your@email.com"
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-default mb-2">
          Attending <span class="text-red-500">*</span>
        </label>
        <div class="space-y-3">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="radio" name="attending" value="yes" required class="w-4 h-4 text-primary focus:ring-primary" />
            <span class="text-default">Joyfully attending</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="radio" name="attending" value="no" class="w-4 h-4 text-primary focus:ring-primary" />
            <span class="text-default">Regretfully declining</span>
          </label>
        </div>
      </div>

      <div>
        <label for="guests" class="block text-sm font-medium text-default mb-2">
          Number of Guests
        </label>
        <select
          id="guests"
          name="guests"
          class="w-full px-4 py-3 rounded-md border border-border/40 bg-page text-default focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
        >
          <option value="1">1 (Just me)</option>
          <option value="2">2 (Me + plus-one)</option>
          <option value="3">3</option>
          <option value="4">4</option>
        </select>
      </div>

      <div>
        <label for="dietary" class="block text-sm font-medium text-default mb-2">
          Dietary Restrictions
        </label>
        <textarea
          id="dietary"
          name="dietary"
          rows={3}
          class="w-full px-4 py-3 rounded-md border border-border/40 bg-page text-default focus:ring-2 focus:ring-primary focus:border-primary outline-none transition resize-none"
          placeholder="Any allergies or dietary needs?"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full btn-primary py-4 text-lg font-serif"
      >
        Send RSVP
      </button>
    </form>
  </div>
</section>
