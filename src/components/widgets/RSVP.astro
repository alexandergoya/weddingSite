---

---

<section id="rsvp" class="py-12 md:py-16 bg-page">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8">
      <h2 class="font-serif text-4xl md:text-5xl text-heading mb-4">RSVP</h2>
    </div>

    <form
      action="https://formspree.io/f/mdavdaqy"
      method="POST"
      class="bg-card rounded-lg shadow-sm p-8 border border-border/20 space-y-6"
    >
      <div>
        <label for="name" class="block text-sm font-medium text-default mb-2">
          Full Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-4 py-3 rounded-md border border-border bg-page text-default focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
          placeholder="Your name"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-default mb-2">
          Email <span class="text-red-500">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-4 py-3 rounded-md border border-border bg-page text-default focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
          placeholder="your@email.com"
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-default mb-2">
          Attending <span class="text-red-500">*</span>
        </label>
        <div class="space-y-3">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="radio" name="attending" value="yes" required class="w-4 h-4 text-primary focus:ring-primary" />
            <span class="text-default">Joyfully attending</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="radio" name="attending" value="no" class="w-4 h-4 text-primary focus:ring-primary" />
            <span class="text-default">Regretfully declining</span>
          </label>
        </div>
      </div>

      <div id="rsvp-details" class="space-y-6 hidden">
        <div id="guestsDropdown">
          <label for="guests" class="block text-sm font-medium text-default mb-2"> Number of Guests </label>
          <select
            id="guests"
            name="guests"
            class="w-full px-4 py-3 rounded-md border border-border bg-page text-default focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
          >
            <option value="1">1 (Go on with your bad self)</option>
            <option value="2">2 (Me plus one hot date)</option>
          </select>
        </div>
        <div id="guestNameDiv" class="hidden">
          <label for="guest full name" class="block text-sm font-medium text-default mb-2"> Full Name of Guest </label>
          <input
            type="text"
            id="guestname"
            name="guestname"
            class="w-full px-4 py-3 rounded-md border border-border bg-page text-default focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
            placeholder="Your guest's name"
          />
        </div>
        <div>
          <label for="address" class="block text-sm font-medium text-default mb-2"> Mailing Address </label>
          <textarea
            id="address"
            name="address"
            rows={3}
            class="w-full px-4 py-3 rounded-md border border-border bg-page text-default focus:ring-2 focus:ring-primary focus:border-primary outline-none transition resize-none"
            placeholder="Where should we send your formal invitation?"></textarea>
        </div>

        <div>
          <label for="dietary" class="block text-sm font-medium text-default mb-2"> Dietary Restrictions </label>
          <textarea
            id="dietary"
            name="dietary"
            rows={3}
            class="w-full px-4 py-3 rounded-md border border-border bg-page text-default focus:ring-2 focus:ring-primary focus:border-primary outline-none transition resize-none"
            placeholder="Any allergies or dietary needs?"></textarea>
        </div>
      </div>
      <button type="submit" class="w-full btn-primary py-4 text-lg font-serif"> Send RSVP </button>

      <script>
        const rsvpDetails = document.getElementById('rsvp-details');
        const attendingRadios = document.querySelectorAll<HTMLInputElement>('input[name="attending"]');

        attendingRadios.forEach((radio) => {
          radio.addEventListener('change', () => {
            if (radio.checked && radio.value === 'yes') {
              rsvpDetails?.classList.remove('hidden');
            } else {
              rsvpDetails?.classList.add('hidden');
            }
          });
        });

        const guestsSelect = document.querySelector<HTMLSelectElement>('#guestsDropdown select');
        const guestNameDiv = document.getElementById('guestNameDiv');

        guestsSelect?.addEventListener('change', () => {
          if (guestsSelect.value === '2') {
            guestNameDiv?.classList.remove('hidden');
          } else {
            guestNameDiv?.classList.add('hidden');
          }
        });
      </script>
    </form>
  </div>
</section>
