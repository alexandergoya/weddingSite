---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';

const posts = await getCollection('post', (entry) => !entry.data.draft);
posts.sort((a, b) => (b.data.publishDate?.valueOf() ?? 0) - (a.data.publishDate?.valueOf() ?? 0));

const renderedPosts = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await render(post);
    return { ...post, Content };
  })
);
---

<section id="announcements" class="py-20 md:py-28 bg-page">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-accent font-serif text-sm tracking-widest uppercase mb-2">Latest Updates</p>
      <h2 class="font-serif text-4xl md:text-5xl text-heading">Announcements</h2>
    </div>

    {
      renderedPosts.length > 0 ? (
        <div class="space-y-12">
          {renderedPosts.map((post) => (
            <article class="bg-card rounded-lg shadow-sm p-6 md:p-8 border border-border/20">
              <div class="flex items-center gap-2 text-muted text-sm mb-3">
                <Icon name="tabler:calendar" class="w-4 h-4" />
                <time datetime={post.data.publishDate?.toISOString() ?? ''}>
                  {(post.data.publishDate ?? new Date()).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </div>
              <h3 class="font-serif text-2xl text-heading mb-3">{post.data.title}</h3>
              <div class="prose prose-lg max-w-none prose-headings:font-serif prose-a:text-primary">
                <post.Content />
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-12 text-muted">
          <Icon name="tabler:bell" class="w-12 h-12 mx-auto mb-4 opacity-50" />
          <p>Announcements coming soon!</p>
        </div>
      )
    }
  </div>
</section>
